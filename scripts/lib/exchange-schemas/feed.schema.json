{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.piraiders.invalid/exchange/feed.schema.json",
  "x-contract": "piraiders-event-feed/1",
  "title": "To Engine/feed.json (draft 0.3.1, not frozen)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "feedId",
    "epoch",
    "createdAt",
    "publisher"
  ],
  "properties": {
    "contractVersion": {
      "const": "piraiders-event-feed/1"
    },
    "feedId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "publisher": {
      "const": "PiRaiders Scheduler"
    }
  }
}
