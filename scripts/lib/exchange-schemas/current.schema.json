      "$ref": "selection.schema.json#/$defs/generation"
    },
    "generationSequence": {
      "$ref": "selection.schema.json#/$defs/seq"
    },
    "manifestPath": {
      "$ref": "selection.schema.json#/$defs/manifestPath"
    },
    "manifestSha256": {
      "$ref": "selection.schema.json#/$defs/sha256"
    },
    "playbackFingerprint": {
      "$ref": "selection.schema.json#/$defs/sha256"
    },
    "metadataFingerprint": {
      "$ref": "selection.schema.json#/$defs/sha256"
    },
    "manifestState": {
      "$ref": "selection.schema.json#/$defs/manifestState"
